# Backend runtime config
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/itinera_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRATION=604800000
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
AUTH_MAX_ADMIN_COUNT=2
AUTHORIZED_ADMIN_EMAILS=admin@itinera.com
# Seeds demo accounts with well-known passwords (see DataSeederConfig) - keep
# true for local dev, must be false in any shared/production environment.
SEED_DEMO_USERS=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081,exp://localhost:19000,https://myitineri.com,https://www.myitineri.com
# TripJack Flight/Hotel API (production key - already live, used by flights/hotels/activities)
TRIPJACK_BASE_URL=https://apitest.tripjack.com
TRIPJACK_API_KEY=
TRIPJACK_HOTEL_BASE_URL=https://apitest-hms.tripjack.com
TRIPJACK_HOTEL_BOOKER_BASE_URL=https://apitest-hotel-booker.tripjack.com
# Separate UAT/certification key for NEW TripJack products (Cabs, TripSafe)
# only - keeps certification testing off the production key above.
TRIPJACK_TEST_API_KEY=
TRIPJACK_CABS_BASE_URL=https://apitest-cabs.tripjack.com
# TripJack account's numeric User Id (from their portal) - required on every
# Cabs Book request.
TRIPJACK_CABS_AGENT_ID=
TRIPJACK_TRIPSAFE_BASE_URL=https://apitest.tripjack.com
# Cabs + TripSafe production (certified 2026-09) - shared domain, uses
# TRIPJACK_API_KEY above, never the test key.
TRIPJACK_CABS_PROD_BASE_URL=https://tripjack.com
TRIPJACK_TRIPSAFE_PROD_BASE_URL=https://tripjack.com
# Production account's numeric User Id - distinct from TRIPJACK_CABS_AGENT_ID
# (the UAT/test account) above.
TRIPJACK_CABS_PROD_AGENT_ID=
# HotelBeds/HBX Group Activities API (separate provider from TripJack)
ACTIVITIES_BASE_URL=https://api.test.hotelbeds.com
ACTIVITIES_API_KEY=
ACTIVITIES_SECRET=
# Gemini API (Google AI Studio free tier) - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
LOG_LEVEL=INFO
LOG_LEVEL_WEB=INFO
